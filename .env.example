# ─────────────────────────────────────────────────────────────────────────────
# 环境变量模板：复制为 .env 后填入真实值
#   cp .env.example .env && ${EDITOR:-vi} .env
# 注意：.env 已被 .gitignore / .dockerignore 排除，切勿提交或打进镜像
# ─────────────────────────────────────────────────────────────────────────────

# ── 服务标识与端口 ───────────────────────────────────────────────────────────
IMPORT_APP_NAME=Enterprise RAG Import Service
QUERY_APP_NAME=Enterprise RAG Query Service
APP_ENV=dev                       # dev / prod（prod 会强校验 JWT 密钥与 CORS）
APP_HOST=0.0.0.0
IMPORT_APP_PORT=55000
QUERY_APP_PORT=55001
CORS_ORIGINS=*                    # 生产建议写具体域名，逗号分隔

# 容器化部署时用于拼接「浏览器可访问」的 MinIO 图片地址
# 注意：该值由 compose 插值读取，**必须写在 deploy/.env**（不是这里！），
#      详见 deploy/README.md 第 4 节；本行仅作说明保留。
# PUBLIC_HOST=192.168.1.10

# ── 问答链路 ─────────────────────────────────────────────────────────────────
SSE_ARTIFICIAL_DELAY=0            # 演示用：SSE 人为延迟秒数
HISTORY_COMPRESS_ENABLED=true
HISTORY_RECENT_LIMIT=10
HISTORY_TOKEN_THRESHOLD=3000
HISTORY_CHUNK_SIZE=4
QUERY_CACHE_ENABLED=true          # 语义缓存总开关
QUERY_CACHE_TTL_SECONDS=900
OUTPUT_RETENTION_DAYS=7           # 导入产物保留天数

# ── 图片描述增强（视觉模型）──────────────────────────────────────────────────
IMAGE_ENHANCE_ENABLED=true        # 关闭或视觉调用异常时自动降级，不阻断导入

# ── LLM（文本 + 视觉，OpenAI 兼容）──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=deepseek-chat            # 视觉模型，用于图片描述

# ── 向量化 / 重排（当前实现走远程 API，无需本地模型与 GPU）──────────────────
# 若改为本地模式：填 BGE_M3_PATH 与 BGE_RERANKER_LARGE 指向模型目录，并保留 BGE_DEVICE
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 本地模型模式（API 模式下留空即可）
BGE_M3_PATH=
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cuda
BGE_FP16=True
BGE_RERANKER_LARGE=
BGE_RERANKER_DEVICE=cuda
BGE_RERANKER_FP16=True

# ── Milvus ──────────────────────────────────────────────────────────────────
MILVUS_URL=http://127.0.0.1:19530   # 容器内改为 http://milvus:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_entities
ITEM_NAME_COLLECTION=kb_item_names

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://127.0.0.1:27017   # 容器内改为 mongodb://mongo:27017
MONGO_DB_NAME=enterprise_rag

# ── MinIO（对象存储）────────────────────────────────────────────────────────
# 注意：endpoint 会拼进图片 URL 并交给浏览器访问，必须是浏览器可达的地址
MINIO_ENDPOINT=127.0.0.1:9000         # 容器内改为 ${PUBLIC_HOST}:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=enterprise-rag
MINIO_IMG_DIR=/kb-images
MINIO_SECURE=False

# ── Redis（可选，不填则跨 worker SSE 会话回退内存）──────────────────────────
REDIS_URL=

# ── MinerU（PDF → Markdown 外部 API）────────────────────────────────────────
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=

# ── 百炼 Web 搜索 MCP ───────────────────────────────────────────────────────
MCP_DASHSCOPE_BASE_URL=

# ── 认证与安全 ──────────────────────────────────────────────────────────────
# 生产必须替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_REMEMBER_DAYS=30
JWT_SSE_TOKEN_EXPIRE_MINUTES=5
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=300

# ── 可选 ────────────────────────────────────────────────────────────────────
PROJECT_ROOT=                     # 留空则按 app 包位置自动推导
